# Fleet orchestrator — environment configuration
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local

# DeepSeek API key (required)
DEEPSEEK_API_KEY=sk-...

# Worker model (optional, defaults to deepseek-v4-pro)
# WORKER_MODEL=deepseek-v4-pro

# DeepSeek Anthropic-compatible endpoint (optional)
# DEEPSEEK_BASE=https://api.deepseek.com/anthropic
