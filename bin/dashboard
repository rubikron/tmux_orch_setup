#!/usr/bin/env python3
# dashboard — a live, animated control-panel view of the Claude Code Fleet.
#
# Usage:
#   bin/dashboard                     # auto-detect FLEET_DIR, serve on :7373
#   FLEET_DIR=/path/.fleet bin/dashboard --port 8080
#   bin/dashboard --open              # also open the page in your browser
#
# Read-only. Safe to run anytime, even while the fleet is active. It parses the
# same files fleet-status does — board.json, comms.log, inbox/, claims.tsv,
# merge-queue, metrics.jsonl, topology — and serves them as JSON at /api/state,
# plus a self-contained HTML page at / that renders the operation as a live
# operations map: the orchestrator and workers as status nodes wired together,
# each new message animating as a token gliding from sender to recipient, inbox
# queues, the task board, the merge queue, and a scannable activity log. Pure
# Python stdlib, no dependencies, no build step.
import argparse
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

# ---- resolve coordination dir (mirrors bin/status) --------------------------
def resolve_fleet_dir():
    d = os.environ.get("FLEET_DIR", "").strip()
    if d and os.path.isdir(d):
        return d
    cur = os.getcwd()
    while cur != "/":
        cand = os.path.join(cur, ".fleet")
        if os.path.isdir(cand):
            return cand
        cur = os.path.dirname(cur)
    return None


# ---- parsers ----------------------------------------------------------------
SESSIONS = ["orchestrator", "worker1", "worker2", "worker3", "worker4"]
KNOWN_TYPES = {"TASK", "ANS", "DONE", "BLOCKED", "REVISE", "FYI", "ASK"}

# "<ts> [<sender> -> <target>] <body>"
COMMS_RE = re.compile(r"^(\S+)\s+\[([^\]]+?)\s*->\s*([^\]]+?)\]\s*(.*)$")


def classify(body):
    """Derive a message type from the body's leading token."""
    if not body:
        return "MSG"
    first = body.split(None, 1)[0]
    if first == "(raw)":
        return "RAW"
    if first in KNOWN_TYPES:
        return first
    return "MSG"


def parse_comms(path, tail=300):
    """Return (messages, total). Each message carries its true line index (seq)
    so the browser can animate only lines it has not seen yet."""
    if not os.path.isfile(path):
        return [], 0
    try:
        with open(path, "r", errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return [], 0
    total = len(lines)
    start = max(0, total - tail)
    out = []
    for i in range(start, total):
        line = lines[i]
        m = COMMS_RE.match(line)
        if not m:
            continue
        ts, sender, target, body = m.groups()
        out.append({
            "seq": i,
            "ts": ts,
            "sender": sender,
            "target": target,
            "type": classify(body),
            "text": body,
        })
    return out, total


def load_board(path):
    if not os.path.isfile(path):
        return [], []
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return [], []
    tasks = []
    for t in data.get("tasks", []):
        tasks.append({
            "id": t.get("id", "?"),
            "state": t.get("state", "QUEUED"),
            "assignee": t.get("assignee", ""),
            "files": t.get("files", []) or [],
            "deps": t.get("deps", []) or [],
            "revises": t.get("revises", 0) or 0,
            "notes": t.get("notes", "") or "",
        })
    return tasks, data.get("reflections", [])


def load_inbox(inbox_dir):
    """session -> number of undrained mail lines."""
    counts = {}
    if not os.path.isdir(inbox_dir):
        return counts
    for name in os.listdir(inbox_dir):
        p = os.path.join(inbox_dir, name)
        if not os.path.isfile(p) or ".drain." in name:
            continue
        try:
            with open(p, "r", errors="replace") as f:
                n = sum(1 for ln in f if ln.strip())
        except OSError:
            n = 0
        if n:
            counts[name] = n
    return counts


def load_claims(path):
    """claims.tsv rows: task \\t worker \\t file (status prints $3 file, $1 task)."""
    rows = []
    if not os.path.isfile(path):
        return rows
    try:
        with open(path, "r", errors="replace") as f:
            for ln in f:
                parts = ln.rstrip("\n").split("\t")
                if len(parts) >= 3 and parts[0]:
                    rows.append({"task": parts[0], "worker": parts[1], "file": parts[2]})
    except OSError:
        pass
    return rows


def load_merge_queue(path):
    rows = []
    if not os.path.isfile(path):
        return rows
    try:
        with open(path, "r", errors="replace") as f:
            for ln in f:
                parts = ln.rstrip("\n").split("\t")
                if parts and parts[0]:
                    rows.append({
                        "task": parts[0],
                        "branch": parts[1] if len(parts) > 1 else "",
                        "worker": parts[2] if len(parts) > 2 else "",
                    })
    except OSError:
        pass
    return rows


def load_topology(path):
    modes = {}
    if not os.path.isfile(path):
        return modes
    try:
        with open(path) as f:
            for ln in f:
                if "=" in ln:
                    k, v = ln.strip().split("=", 1)
                    modes[k] = v
    except OSError:
        pass
    return modes


def load_live(path):
    """Supervisor liveness: {name: alive_bool}, or None if no live.json yet."""
    if not os.path.isfile(path):
        return None
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    return {k: bool(v.get("alive")) for k, v in data.items()}


def tmux_sessions():
    """Live tmux session names, or None if tmux is unavailable."""
    import subprocess
    try:
        out = subprocess.run(
            ["tmux", "list-sessions", "-F", "#{session_name}"],
            capture_output=True, text=True, timeout=3,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return set()
    return {s.strip() for s in out.stdout.splitlines() if s.strip()}


def load_supervisor(fleet_dir):
    """Read supervisor.json (host/port/pid/token). None if missing/unreadable."""
    path = os.path.join(fleet_dir, "supervisor.json")
    if not os.path.isfile(path):
        return None
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def forward_chat_message(supervisor, to, text):
    """POST {from,to,text} to the supervisor's loopback /msg endpoint.
    Returns (status_code, body_dict). Never raises — network/parse failures
    are surfaced as a 502 with an error body."""
    host = supervisor.get("host", "127.0.0.1")
    port = supervisor.get("port")
    token = supervisor.get("token", "")
    url = f"http://{host}:{port}/msg"
    payload = json.dumps({"from": "human", "to": to, "text": text}).encode("utf-8")
    req = urllib.request.Request(url, data=payload, method="POST")
    req.add_header("Content-Type", "application/json")
    req.add_header("X-Fleet-Token", token)
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            body = resp.read()
            try:
                return resp.status, json.loads(body)
            except ValueError:
                return resp.status, {"raw": body.decode("utf-8", "replace")}
    except urllib.error.HTTPError as e:
        body = e.read()
        try:
            return e.code, json.loads(body)
        except ValueError:
            return e.code, {"error": body.decode("utf-8", "replace") or str(e)}
    except (urllib.error.URLError, OSError, TimeoutError) as e:
        return 502, {"error": f"could not reach supervisor: {e}"}


def _tool_preview(tool_input, limit=90):
    """A short, single-line preview of a tool_use input for the compact log row."""
    try:
        s = json.dumps(tool_input, separators=(",", ":"), default=str)
    except (TypeError, ValueError):
        s = str(tool_input)
    s = " ".join(s.split())
    return s if len(s) <= limit else s[: limit - 1] + "…"


def parse_chat_events(path, since=0):
    """Return (messages, total_lines) for an agent's events/<agent>.jsonl,
    mapping each JSON line at index i >= since into zero or more chat
    messages. Unparseable or irrelevant lines (system/init, rate_limit,
    stderr) are skipped, never raised."""
    if not os.path.isfile(path):
        return [], 0
    try:
        with open(path, "r", errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return [], 0
    total = len(lines)
    start = max(0, since)
    out = []
    for i in range(start, total):
        line = lines[i].strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        etype = ev.get("type")
        if etype == "assistant":
            content = ((ev.get("message") or {}).get("content")) or []
            for block in content:
                btype = block.get("type")
                if btype == "text" and block.get("text"):
                    out.append({"seq": i, "role": "assistant", "kind": "text", "text": block["text"]})
                elif btype == "tool_use":
                    out.append({
                        "seq": i, "role": "assistant", "kind": "tool",
                        "text": block.get("name", "tool"),
                        "detail": _tool_preview(block.get("input", {})),
                    })
        elif etype == "result":
            out.append({
                "seq": i, "role": "assistant", "kind": "result",
                "text": ev.get("result", "") or "",
                "cost": ev.get("total_cost_usd"),
                "turns": ev.get("num_turns"),
                "isError": bool(ev.get("is_error")),
            })
        # system/init, rate_limit_event, stderr, and anything else: skip silently
    return out, total


# SSE tail poll interval: fast enough to feel like real-time token streaming,
# slow enough not to peg a CPU core across a handful of open chat panels.
CHAT_STREAM_POLL_SECONDS = 0.12
CHAT_STREAM_KEEPALIVE_SECONDS = 15


def _line_offset(path, n):
    """Byte offset in `path` immediately after its n-th line (n lines fully
    consumed), or None if the file doesn't exist yet or has fewer than n
    lines. n<=0 => offset 0 (start of file)."""
    if n <= 0:
        return 0
    if not os.path.isfile(path):
        return None
    offset = 0
    count = 0
    try:
        with open(path, "rb") as f:
            for raw in f:
                offset += len(raw)
                count += 1
                if count >= n:
                    return offset
    except OSError:
        return None
    return None


def build_state(fleet_dir):
    comms_path = os.path.join(fleet_dir, "comms.log")
    messages, total_msgs = parse_comms(comms_path)
    tasks, reflections = load_board(os.path.join(fleet_dir, "board.json"))
    inbox = load_inbox(os.path.join(fleet_dir, "inbox"))
    claims = load_claims(os.path.join(fleet_dir, "claims.tsv"))
    queue = load_merge_queue(os.path.join(fleet_dir, "merge-queue"))
    modes = load_topology(os.path.join(fleet_dir, "topology"))
    # Supervisor transport (default): liveness from live.json. tmux transport
    # (legacy): liveness from `tmux list-sessions`. Detected by supervisor.json.
    supervisor = os.path.isfile(os.path.join(fleet_dir, "supervisor.json"))
    live_map = load_live(os.path.join(fleet_dir, "live.json"))
    tmux_live = None if supervisor else tmux_sessions()

    # per-session liveness, respecting topology (native != down)
    sessions = []
    for name in SESSIONS:
        mode = modes.get(name, "tmux")
        if live_map is not None:
            status = "up" if live_map.get(name) else "down"
        elif tmux_live is None:
            status = "unknown"
        elif name in tmux_live:
            status = "up"
        elif mode == "native":
            status = "native"
        else:
            status = "down"
        sessions.append({"name": name, "mode": mode, "status": status})

    # what is each worker doing? derived from the active/blocked task it owns.
    activity = {}
    for t in tasks:
        who = t["assignee"]
        if not who:
            continue
        if t["state"] == "ACTIVE":
            activity[who] = {"kind": "working", "task": t["id"], "notes": t["notes"]}
        elif t["state"] == "BLOCKED" and activity.get(who, {}).get("kind") != "working":
            activity[who] = {"kind": "blocked", "task": t["id"], "notes": t["notes"]}

    first_ts = messages[0]["ts"] if messages else None
    counts = {
        "total": len(tasks),
        "queued": sum(1 for t in tasks if t["state"] == "QUEUED"),
        "active": sum(1 for t in tasks if t["state"] == "ACTIVE"),
        "blocked": sum(1 for t in tasks if t["state"] == "BLOCKED"),
        "merged": sum(1 for t in tasks if t["state"] == "MERGED"),
        "messages": total_msgs,
        "revises": sum(1 for m in messages if m["type"] == "REVISE"),
    }
    return {
        "sessions": sessions,
        "activity": activity,
        "tasks": tasks,
        "reflections": reflections,
        "messages": messages,
        "inbox": inbox,
        "claims": claims,
        "queue": queue,
        "counts": counts,
        "firstTs": first_ts,
    }


