#!/usr/bin/env bash
# learn — post-run analysis for the Claude Code Fleet.
#
# Usage:
#   bin/learn [--json]             # auto-detect FLEET_DIR
#   FLEET_DIR=/path/to/.fleet bin/learn
#
# Reads metrics.jsonl, comms.log, and BOARD.md to produce a structured
# analysis of the fleet run. Appends findings to .fleet/learnings.md
# and prints a summary to stdout.
#
# Flags:
#   --json    Output the analysis as JSON instead of the default markdown summary.
set -euo pipefail

# ---- resolve coordination dir -----------------------------------------------
FLEET_DIR="${FLEET_DIR:-}"
if [[ -z "$FLEET_DIR" ]]; then
  dir="$(pwd)"
  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/.fleet" ]]; then
      FLEET_DIR="$dir/.fleet"
      break
    fi
    dir="$(dirname "$dir")"
  done
fi

if [[ -z "$FLEET_DIR" || ! -d "$FLEET_DIR" ]]; then
  echo "learn: no .fleet/ coordination dir found" >&2
  exit 1
fi

JSON_OUT=0
if [[ "${1:-}" == "--json" ]]; then
  JSON_OUT=1
fi

metrics="$FLEET_DIR/metrics.jsonl"
comms="$FLEET_DIR/comms.log"
board="$FLEET_DIR/BOARD.md"
learnings="$FLEET_DIR/learnings.md"

# ---- helpers -----------------------------------------------------------------
dim()  { printf '\033[2m%s\033[0m' "$1"; }
bold() { printf '\033[1m%s\033[0m' "$1"; }
green() { printf '\033[32m%s\033[0m' "$1"; }
red()   { printf '\033[31m%s\033[0m' "$1"; }

# Bash 3.2 compat: use functions instead of associative arrays.
# grep -c always outputs a count (0 or more) on stdout; exit code 1 on zero
# matches is expected — we only want the stdout value, so suppress stderr.
worker_assigned()  { grep -c "\"assignee\":\"$1\"" "$metrics" 2>/dev/null || true; }
worker_merged()    { grep "\"assignee\":\"$1\"" "$metrics" 2>/dev/null | grep -c '"outcome":"merged"' 2>/dev/null || true; }
worker_blocked()   { grep "\"assignee\":\"$1\"" "$metrics" 2>/dev/null | grep -c '"outcome":"blocked"' 2>/dev/null || true; }
worker_revised()   { grep "\"assignee\":\"$1\"" "$metrics" 2>/dev/null | grep -c '"revises":[1-9]' 2>/dev/null || true; }
ttype_assigned()   { grep -c "\"type\":\"$1\"" "$metrics" 2>/dev/null || true; }
ttype_revised()    { grep "\"type\":\"$1\"" "$metrics" 2>/dev/null | grep -c '"revises":[1-9]' 2>/dev/null || true; }

# ---- check we have data -----------------------------------------------------
if [[ ! -f "$metrics" || ! -s "$metrics" ]]; then
  echo "learn: no metrics.jsonl data yet — run the fleet first" >&2
  exit 0
fi

# ---- parse metrics.jsonl ----------------------------------------------------
total_tasks=$(wc -l < "$metrics" | tr -d ' ')
merged_count=$(grep -c '"outcome":"merged"' "$metrics" 2>/dev/null || true)
blocked_count=$(grep -c '"outcome":"blocked"' "$metrics" 2>/dev/null || true)
abandoned_count=$(grep -c '"outcome":"abandoned"' "$metrics" 2>/dev/null || true)

# File-count vs REVISE rate
single_file=$(grep -c '"files":1[,}]' "$metrics" 2>/dev/null || true)
single_file_revised=$(grep '"files":1[,}]' "$metrics" 2>/dev/null | grep -c '"revises":[1-9]' 2>/dev/null || true)
multi_file=$(grep -cv '"files":1[,}]' "$metrics" 2>/dev/null || true)
multi_file_revised=$(grep -v '"files":1[,}]' "$metrics" 2>/dev/null | grep -c '"revises":[1-9]' 2>/dev/null || true)

# Revise stats
total_revises=$(grep -o '"revises":[0-9]*' "$metrics" 2>/dev/null | awk -F: '{s+=$2} END {print s+0}' || true)
tasks_revised=$(grep -c '"revises":[1-9]' "$metrics" 2>/dev/null || true)

# ---- parse comms.log --------------------------------------------------------
if [[ -f "$comms" && -s "$comms" ]]; then
  msg_total=$(wc -l < "$comms" | tr -d ' ')
  task_msgs=$(grep -cE '\bTASK\b' "$comms" 2>/dev/null || true)
  done_msgs=$(grep -cE '\bDONE\b' "$comms" 2>/dev/null || true)
  ask_msgs=$(grep -cE '\bASK\b' "$comms" 2>/dev/null || true)
  ans_msgs=$(grep -cE '\bANS\b' "$comms" 2>/dev/null || true)
  revise_msgs=$(grep -cE '\bREVISE\b' "$comms" 2>/dev/null || true)
  blocked_msgs=$(grep -cE '\bBLOCKED\b' "$comms" 2>/dev/null || true)
  first_ts=$(head -1 "$comms" 2>/dev/null | cut -d' ' -f1)
  last_ts=$(tail -1 "$comms" 2>/dev/null | cut -d' ' -f1)
else
  msg_total=0; task_msgs=0; done_msgs=0; ask_msgs=0; ans_msgs=0
  revise_msgs=0; blocked_msgs=0; first_ts=""; last_ts=""
fi

# ---- parse BOARD.md ---------------------------------------------------------
board_section=""
if [[ -f "$board" ]]; then
  if grep -q '## Reflections' "$board" 2>/dev/null; then
    board_section=$(sed -n '/## Reflections/,$ p' "$board" 2>/dev/null || echo "")
  fi
fi

# ---- compute percentages ----------------------------------------------------
pct_revised=0
if [[ "$total_tasks" -gt 0 ]]; then
  pct_revised=$(( tasks_revised * 100 / total_tasks ))
fi

pct_single_revised=0
if [[ "$single_file" -gt 0 ]]; then
  pct_single_revised=$(( single_file_revised * 100 / single_file ))
fi

pct_multi_revised=0
if [[ "$multi_file" -gt 0 ]]; then
  pct_multi_revised=$(( multi_file_revised * 100 / multi_file ))
fi

# ---- generate suggestions ---------------------------------------------------
suggestions=""
WORKERS="worker1 worker2 worker3 worker4"
for w in $WORKERS; do
  assigned=$(worker_assigned "$w")
  if [[ "$assigned" -eq 0 ]]; then
    continue
  fi
  revised=$(worker_revised "$w")
  pct=0
  if [[ "$assigned" -gt 0 ]]; then
    pct=$(( revised * 100 / assigned ))
  fi
  if [[ "$pct" -ge 50 ]]; then
    suggestions+="- **$w** had $revised/$assigned tasks revised ($pct%) — check if its prompt needs clearer guidance."$'\n'
  fi
done

if [[ "$pct_multi_revised" -gt "$pct_single_revised" ]] && [[ "$multi_file" -gt 0 ]]; then
  suggestions+="- Multi-file tasks had ${pct_multi_revised}% REVISE rate vs ${pct_single_revised}% for single-file — tighten task granularity."$'\n'
fi

# Worker utilization: flag if one worker at < 25% of the busiest
busiest_count=0
lowest_count=999
lowest_util=""
for w in $WORKERS; do
  assigned=$(worker_assigned "$w")
  if [[ "$assigned" -gt "$busiest_count" ]]; then
    busiest_count=$assigned
  fi
  if [[ "$assigned" -gt 0 && "$assigned" -lt "$lowest_count" ]]; then
    lowest_count=$assigned
    lowest_util=$w
  fi
done
if [[ "$busiest_count" -gt 0 && "$lowest_count" -gt 0 && "$lowest_count" -lt 999 ]]; then
  imbalance=$(( busiest_count * 100 / lowest_count ))
  if [[ "$imbalance" -ge 400 ]]; then
    suggestions+="- **$lowest_util** was underutilized ($lowest_count tasks vs $busiest_count) — consider whether tasks exist that fit its role."$'\n'
  fi
fi

if [[ -z "$suggestions" ]]; then
  suggestions="- No obvious patterns — the run looks balanced."$'\n'
fi

# ---- output -----------------------------------------------------------------
session_date=$(date '+%Y-%m-%d')

if [[ "$JSON_OUT" -eq 1 ]]; then
  # Machine-parseable output
  cat <<JSON
{
  "date": "$session_date",
  "tasks": {"total": $total_tasks, "merged": $merged_count, "blocked": $blocked_count, "abandoned": $abandoned_count},
  "revises": {"total": $total_revises, "tasks_revised": $tasks_revised, "pct_revised": $pct_revised},
  "messages": {"total": $msg_total, "task": $task_msgs, "done": $done_msgs, "ask": $ask_msgs, "ans": $ans_msgs, "revise": $revise_msgs, "blocked": $blocked_msgs},
  "workers": {
    $(for w in $WORKERS; do
      assigned=$(worker_assigned "$w")
      merged=$(worker_merged "$w")
      blocked=$(worker_blocked "$w")
      revised=$(worker_revised "$w")
      printf '"%s": {"assigned": %s, "merged": %s, "blocked": %s, "revised": %s}' "$w" "$assigned" "$merged" "$blocked" "$revised"
      [[ "$w" != "worker4" ]] && echo ","
    done)
  },
  "single_file_revise_pct": $pct_single_revised,
  "multi_file_revise_pct": $pct_multi_revised,
  "duration": {"first": "$first_ts", "last": "$last_ts"}
}
JSON
else
  # Human-readable summary
  cat <<SUMMARY

=== $(bold "Fleet Post-Run Analysis") $(dim "$session_date") ===

$(bold "Tasks")
  Total:   $total_tasks ($(green "$merged_count") merged, $(red "$blocked_count") blocked, $abandoned_count abandoned)
  REVISEs: $total_revises across $tasks_revised tasks (${pct_revised}%)

$(bold "Workers")
SUMMARY
  for w in $WORKERS; do
    assigned=$(worker_assigned "$w")
    if [[ "$assigned" -gt 0 ]]; then
      merged=$(worker_merged "$w")
      revised=$(worker_revised "$w")
      printf "  %s: %s/%s merged, %s revised\n" "$w" "$merged" "$assigned" "$revised"
    fi
  done

  cat <<SUMMARY

$(bold "Task Types")
SUMMARY
  for t in feature bugfix refactor test ui-review; do
    assigned=$(ttype_assigned "$t")
    if [[ "$assigned" -gt 0 ]]; then
      revised=$(ttype_revised "$t")
      printf "  %s: %s tasks, %s revised\n" "$t" "$assigned" "$revised"
    fi
  done

  cat <<SUMMARY

$(bold "File Count vs Quality")
  Single-file tasks: $single_file (${pct_single_revised}% revised)
  Multi-file tasks:  $multi_file (${pct_multi_revised}% revised)

$(bold "Messages")
  Total: $msg_total (TASK $task_msgs, DONE $done_msgs, ASK $ask_msgs, ANS $ans_msgs, REVISE $revise_msgs, BLOCKED $blocked_msgs)

$(bold "Duration")
  First message: $first_ts
  Last message:  $last_ts

$(bold "Suggestions")
$suggestions
SUMMARY

  if [[ -n "$board_section" ]]; then
    echo
    bold "Orchestrator Reflections"
    echo
    echo "$board_section"
  fi

  echo
  dim "Full report appended to $learnings"
  echo
fi

# ---- append to learnings.md ------------------------------------------------
{
  echo
  echo "## Session $session_date"
  echo
  echo "- **$total_tasks tasks**: $merged_count merged, $blocked_count blocked, $abandoned_count abandoned"
  echo "- **REVISE rate**: ${pct_revised}% ($tasks_revised tasks)"
  echo "- **Messages**: $msg_total total"
  echo "- **Duration**: $first_ts → $last_ts"
  echo
  echo "### Worker breakdown"
  for w in $WORKERS; do
    assigned=$(worker_assigned "$w")
    if [[ "$assigned" -gt 0 ]]; then
      merged=$(worker_merged "$w")
      revised=$(worker_revised "$w")
      echo "- $w: $merged/$assigned merged, $revised revised"
    fi
  done
  echo
  echo "### Suggestions"
  echo "$suggestions"
  if [[ -n "$board_section" ]]; then
    echo
    echo "### Orchestrator Reflections"
    echo "$board_section"
  fi
} >> "$learnings"

# ---- auto-create if it didn't exist ----------------------------------------
if [[ ! -f "$learnings" ]]; then
  touch "$learnings"
fi
