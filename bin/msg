#!/usr/bin/env bash
# msg — send a one-line message (a "user turn") to another agent.
#
# Usage:  fleet-msg <target-agent> <message...>
# Example: fleet-msg worker1 "TASK t-014: read $FLEET_DIR/tasks/t-014.md"
#
# Transport is auto-detected:
#   - supervisor mode (default): if $FLEET_DIR/supervisor.json exists, POST the
#     message to the local supervisor, which writes it to the target agent's
#     stdin and records it in comms.log. No tmux, no global session names.
#   - tmux mode (fallback): type the line into the target tmux session with
#     send-keys and append to comms.log ourselves (legacy behavior).
set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "usage: $(basename "$0") <target-agent> <message...>" >&2
  exit 1
fi

target="$1"; shift
msg="$*"

# Sender identity: supervisor launches each agent with FLEET_AGENT set; fall back
# to the tmux session name, then to "human" for a hand-typed message.
sender="${FLEET_AGENT:-$(tmux display-message -p '#S' 2>/dev/null || echo human)}"

# Reject embedded newlines — the protocol is one message per line, and comms.log
# parsing is line-based in both transports.
if [[ "$msg" == *$'\n'* ]]; then
  echo "$(basename "$0"): message contains embedded newlines — put multi-line content in a task file, not a message" >&2
  exit 1
fi

coord="${FLEET_DIR:-.}"
supervisor_json="$coord/supervisor.json"

# ---- supervisor transport ---------------------------------------------------
if [[ -f "$supervisor_json" ]]; then
  python3 - "$supervisor_json" "$sender" "$target" "$msg" <<'PY'
import json, sys, urllib.request, urllib.error

sup_path, sender, target, text = sys.argv[1:5]
with open(sup_path) as f:
    sup = json.load(f)

url = f"http://{sup['host']}:{sup['port']}/msg"
payload = json.dumps({"from": sender, "to": target, "text": text}).encode()
req = urllib.request.Request(
    url, data=payload, method="POST",
    headers={"Content-Type": "application/json", "X-Fleet-Token": sup.get("token", "")},
)
try:
    with urllib.request.urlopen(req, timeout=5) as r:
        json.load(r)  # {"ok": true}
except urllib.error.HTTPError as e:
    body = e.read().decode(errors="replace")
    sys.stderr.write(f"fleet-msg: supervisor rejected message ({e.code}): {body}\n")
    sys.exit(1)
except urllib.error.URLError as e:
    sys.stderr.write(f"fleet-msg: cannot reach supervisor at {url}: {e.reason}\n")
    sys.exit(1)
PY
  exit $?
fi

# ---- tmux transport (legacy fallback) ---------------------------------------
# Slash commands only register when "/" is the first character on the input line,
# so send them bare; otherwise prefix with "[sender -> target] ".
if [[ "$msg" == /* ]]; then
  line="$msg"
  logline="[$sender -> $target] (raw) $msg"
else
  line="[$sender -> $target] $msg"
  logline="$line"
fi

mkdir -p "$coord"
lockfile="$coord/.lock.$target"
exec 9>"$lockfile" 2>/dev/null || true
if flock -w 2 9 2>/dev/null; then
  tmux send-keys -t "$target" -l "$line"
  tmux send-keys -t "$target" Enter
  flock -u 9 2>/dev/null || true
else
  tmux send-keys -t "$target" -l "$line"
  tmux send-keys -t "$target" Enter
fi
printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$logline" >> "$coord/comms.log"
