#!/usr/bin/env bash
# msg — send a one-line message to another agent's Claude Code session.
#
# Usage:  msg <target-session> <message...>
# Example: msg worker1 "TASK t-014: read $FLEET_DIR/tasks/t-014.md"
#
# It types the message into the target tmux session as if the user typed it,
# then appends the same line to the shared comms.log so every exchange is
# auditable (send-keys itself leaves no record).
set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "usage: msg <target-session> <message...>" >&2
  exit 1
fi

target="$1"; shift
sender="$(tmux display-message -p '#S' 2>/dev/null || echo human)"
line="[$sender -> $target] $*"

# Reject embedded newlines — they would submit a partial line as its own
# Enter-terminated input, silently breaking the one-message-one-line invariant.
if [[ "$line" == *$'\n'* ]]; then
  echo "msg: message contains embedded newlines — put multi-line content in a task file, not a message" >&2
  exit 1
fi

# Shared coordination directory — used by both control and audit planes.
coord="${FLEET_DIR:-.}"
mkdir -p "$coord"

# Control plane: inject the message as a user turn in the target session.
# -l (literal) stops tmux from interpreting characters as key names.
# Wrap in flock so concurrent senders to the same target don't mangle each
# other's lines — the send is two tmux commands and must be atomic.
lockfile="$coord/.lock.$target"
exec {lock_fd}>"$lockfile" 2>/dev/null || true

if [[ -n "${lock_fd:-}" ]] && flock -w 2 "$lock_fd" 2>/dev/null; then
  tmux send-keys -t "$target" -l "$line"
  tmux send-keys -t "$target" Enter
  flock -u "$lock_fd" 2>/dev/null || true
else
  # Graceful degradation: if flock isn't available, send without locking
  tmux send-keys -t "$target" -l "$line"
  tmux send-keys -t "$target" Enter
fi

# Audit plane: one atomic append so the orchestrator (and you) can see all traffic.
printf '%s %s\n' "$(date '+%H:%M:%S')" "$line" >> "$coord/comms.log"
